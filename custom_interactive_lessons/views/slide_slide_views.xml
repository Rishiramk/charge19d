<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_slide_slide_form_interactive" model="ir.ui.view">
        <field name="name">slide.slide.form.interactive</field>
        <field name="model">slide.slide</field>
        <field name="inherit_id" ref="website_slides.view_slide_slide_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main_group']" position="after">
                <group string="Interactive Lesson" name="interactive_lesson_group">
                    <field name="is_interactive_lesson"/>
                    <field name="interactive_html"
                           attrs="{'invisible': [('is_interactive_lesson', '=', False)], 'required': [('is_interactive_lesson', '=', True)]}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
