<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List View for Academic Year -->
        <record id="view_op_academic_year_list" model="ir.ui.view">
            <field name="name">op.academic.year.list</field>
            <field name="model">op.academic.year</field>
            <field name="arch" type="xml">
                <list string="Academic Years">
                    <field name="name"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="term_structure"/>
                </list>
            </field>
        </record>

        <!-- Form View for Academic Year -->
        <record id="view_op_academic_year_form" model="ir.ui.view">
            <field name="name">op.academic.year.form</field>
            <field name="model">op.academic.year</field>
            <field name="arch" type="xml">
                <form string="Academic Year">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(charge_erp_core.action_op_batch)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-sitemap">
                                <field name="batch_count" widget="statinfo" string="Batches"/>
                            </button>
                        </div>
                        <group>
                            <field name="name"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="term_structure"/>
                            <field name="active"/>
                        </group>
                        <notebook>
                            <page string="Academic Terms">
                                <field name="academic_term_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action for Academic Year -->
        <record id="action_op_academic_year" model="ir.actions.act_window">
            <field name="name">Academic Years</field>
            <field name="res_model">op.academic.year</field>
            <field name="view_mode">list,form</field>
        </record>


    </data>
</odoo>
