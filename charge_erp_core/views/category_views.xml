<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List View -->
        <record id="view_op_category_list" model="ir.ui.view">
            <field name="name">op.category.list</field>
            <field name="model">op.category</field>
            <field name="arch" type="xml">
                <list string="Categories">
                    <field name="name"/>
                    <field name="code"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_op_category_form" model="ir.ui.view">
            <field name="name">op.category.form</field>
            <field name="model">op.category</field>
            <field name="arch" type="xml">
                <form string="Category">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_op_category" model="ir.actions.act_window">
            <field name="name">Categories</field>
            <field name="res_model">op.category</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu -->
        <menuitem id="menu_op_category" name="Categories"
                  parent="menu_op_school_root"
                  action="action_op_category"
                  sequence="10"/>

    </data>
</odoo>