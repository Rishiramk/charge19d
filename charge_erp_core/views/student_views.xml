<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List View -->
        <record id="view_op_student_list" model="ir.ui.view">
            <field name="name">op.student.list</field>
            <field name="model">op.student</field>
            <field name="arch" type="xml">
                <list string="Students">
                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="mobile"/>
                    <field name="registration_number"/>
                    <field name="category_id"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_op_student_form" model="ir.ui.view">
            <field name="name">op.student.form</field>
            <field name="model">op.student</field>
            <field name="arch" type="xml">
                <form string="Student">
                    <header>
                        <field name="status" widget="statusbar" statusbar_visible="active,graduated,on_leave"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(charge_erp_core.session_list_action)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-calendar"
                                context="{'search_default_attendee_ids': id}">
                                <field name="session_count" widget="statinfo" string="Sessions"/>
                            </button>
                            <button name="action_view_assignments"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o">
                                <field name="assignment_count" widget="statinfo" string="Assignments"/>
                            </button>
                            <button name="action_view_fees"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-money">
                                <field name="fee_due_count" widget="statinfo" string="Fees"/>
                            </button>
                            <button name="action_view_attendance"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-check-square-o">
                                <field name="attendance_count" widget="statinfo" string="Attendance"/>
                            </button>
                        </div>
                        <field name="image_1920" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <field name="name" invisible="1" force_save="1"/>
                            <h1>
                                <field name="first_name" placeholder="First Name" style="width: 33%"/>
                                <field name="middle_name" placeholder="Middle Name" style="width: 33%"/>
                                <field name="last_name" placeholder="Last Name" style="width: 34%" required="1"/>
                            </h1>
                        </div>
                        <notebook>

                            <!-- Personal Information -->
                            <page string="Personal Information">
                                <group>
                                    <group>
                                        <field name="gender"/>
                                        <field name="birth_date"/>
                                        <field name="blood_group"/>
                                    </group>
                                    <group>
                                        <field name="lang"/>
                                        <field name="nationality"/>
                                        <field name="visa_info"/>
                                        <field name="is_an_alumni"/>
                                    </group>
                                </group>
                            </page>

                            <!-- Contact Information -->
                            <page string="Contact Information">
                                <group>
                                    <field name="phone"/>
                                    <field name="mobile"/>
                                    <field name="email"/>
                                    <field name="emergency_contact_id"/>
                                </group>
                                <field name="address_type"/>
                                <label for="street"/>
                                <div class="o_address_format">
                                    <field name="street"/>
                                    <field name="street2"/>
                                    <field name="city"/>
                                    <field name="state_id"/>
                                    <field name="zip"/>
                                    <field name="country_id"/>
                                </div>
                            </page>

                            <!-- Family Information -->
                            <page string="Family Information">
                                <field name="parent_ids" widget="many2many_tags"/>
                            </page>

                            <!-- Educational -->
                            <page string="Educational">
                                <group>
                                    <group>
                                        <field name="roll_number"/>
                                        <field name="registration_number"/>
                                        <field name="batch_id"/>
                                    </group>
                                    <group>
                                        <field name="program_id"/>
                                    </group>
                                </group>
                                <group string="Academic History">
                                    <field name="previous_education"/>
                                </group>
                                <field name="course_detail_ids">
                                    <list editable="bottom">
                                        <field name="course_id"/>
                                        <field name="academic_year_id"/>
                                        <field name="status"/>
                                    </list>
                                </field>
                            </page>

                            <!-- Other Information -->
                            <page string="Other Information">
                                <group>
                                    <field name="id_number"/>
                                    <field name="library_card"/>
                                    <field name="badge_id"/>
                                    <field name="pin"/>
                                    <field name="category_id"/>
                                    <field name="miscellaneous"/>
                                </group>
                            </page>

                            <!-- Portal Access -->
                            <page string="Portal Access">
                                <group>
                                    <field name="user_id"/>
                                </group>
                            </page>

                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Kanban View -->
        <record id="view_op_student_kanban" model="ir.ui.view">
            <field name="name">op.student.kanban</field>
            <field name="model">op.student</field>
            <field name="arch" type="xml">
                <kanban default_group_by="status">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="batch_id"/>
                    <field name="status"/>
                    <field name="image_128"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <!-- ✅ FIXED: use widget="image" instead of kanban_image() -->
                                    <field name="image_128" widget="image" class="o_kanban_image"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong><field name="name"/></strong>
                                    <ul>
                                        <li>Batch: <field name="batch_id"/></li>
                                        <li>Status: <field name="status"/></li>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Action -->
        <record id="action_op_student" model="ir.actions.act_window">
            <field name="name">Students</field>
            <field name="res_model">op.student</field>
            <field name="view_mode">kanban,list,form</field>
        </record>


    </data>
</odoo>
