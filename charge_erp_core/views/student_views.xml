<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List View -->
        <record id="view_op_student_list" model="ir.ui.view">
            <field name="name">op.student.list</field>
            <field name="model">op.student</field>
            <field name="arch" type="xml">
                <list string="Students">
                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="mobile"/>
                    <field name="registration_number"/>
                    <field name="department_id"/>
                    <field name="category_id"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_op_student_form" model="ir.ui.view">
            <field name="name">op.student.form</field>
            <field name="model">op.student</field>
            <field name="arch" type="xml">
                <form string="Student">
                    <header>
                        <field name="status" widget="statusbar" statusbar_visible="active,graduated,on_leave"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(charge_erp_core.session_list_action)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-calendar"
                                context="{'search_default_attendee_ids': id}">
                                <field name="session_count" widget="statinfo" string="Sessions"/>
                            </button>
                            <button name="action_view_assignments"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-pencil-square-o">
                                <field name="assignment_count" widget="statinfo" string="Assignments"/>
                            </button>
                            <button name="action_view_fees"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-money">
                                <field name="fee_due_count" widget="statinfo" string="Fees"/>
                            </button>
                            <button name="action_view_attendance"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-check-square-o">
                                <field name="attendance_count" widget="statinfo" string="Attendance"/>
                            </button>
                        </div>
                        <field name="image_1920" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <field name="name" invisible="1" force_save="1"/>
                            <h1>
                                <field name="first_name" placeholder="First Name" style="width: 33%"/>
                                <field name="middle_name" placeholder="Middle Name" style="width: 33%"/>
                                <field name="last_name" placeholder="Last Name" style="width: 34%" required="1"/>
                            </h1>
                        </div>
                        <notebook>
                            <page string="Personal Information">
                                <group>
                                    <group string="Personal Details">
                                        <field name="gender"/>
                                        <field name="birth_date"/>
                                        <field name="blood_group"/>
                                        <field name="nationality"/>
                                        <field name="lang"/>
                                    </group>
                                    <group string="Aadhar Information">
                                        <field name="aadhar_number"/>
                                        <field name="aadhar_verified"/>
                                        <field name="aadhar_document" widget="binary" filename="'aadhar_document.pdf'"/>
                                    </group>
                                    <group string="Contact Information">
                                        <field name="phone"/>
                                        <field name="mobile"/>
                                        <field name="email"/>
                                        <field name="emergency_contact_id"/>
                                    </group>
                                    <group string="Family Information">
                                        <field name="parent_ids" widget="many2many_tags"/>
                                    </group>
                                </group>
                                <group string="Mailing Address">
                                     <field name="address_type"/>
                                     <label for="street" string="Address"/>
                                     <div class="o_address_format">
                                         <field name="street" placeholder="Street..."/>
                                         <field name="street2" placeholder="Street 2..."/>
                                         <field name="city" placeholder="City"/>
                                         <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True}"/>
                                         <field name="zip" placeholder="ZIP"/>
                                         <field name="country_id" placeholder="Country" options="{'no_open': True, 'no_create': True}"/>
                                     </div>
                                </group>
                            </page>
                            <page string="Academic Information">
                                <group>
                                    <group string="Academic Details">
                                        <field name="roll_number"/>
                                        <field name="registration_number"/>
                                        <field name="batch_id"/>
                                        <field name="program_id"/>
                                        <field name="department_id"/>
                                        <field name="category_id"/>
                                        <field name="is_an_alumni"/>
                                    </group>
                                    <group string="Other Details">
                                        <field name="id_number"/>
                                        <field name="library_card"/>
                                        <field name="badge_id"/>
                                        <field name="tag_ids" widget="many2many_tags"/>
                                        <field name="miscellaneous"/>
                                    </group>
                                </group>
                                <separator string="Course Enrollments"/>
                                <field name="enrollment_ids">
                                    <list editable="bottom">
                                        <field name="course_id"/>
                                        <field name="academic_year_id"/>
                                        <field name="status"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Portal Access">
                                <group>
                                    <field name="user_id"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Kanban View -->
        <record id="view_op_student_kanban" model="ir.ui.view">
            <field name="name">op.student.kanban</field>
            <field name="model">op.student</field>
            <field name="arch" type="xml">
                <kanban default_group_by="status" color="color">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="batch_id"/>
                    <field name="program_id"/>
                    <field name="email"/>
                    <field name="status"/>
                    <field name="image_128"/>
                    <field name="color"/>
                    <templates>
                        <t t-name="card">
                            <div t-attf-class="oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <field name="image_128" widget="image" class="o_kanban_image"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong><field name="name"/></strong>
                                    <ul>
                                        <li>Program: <field name="program_id"/></li>
                                        <li>Batch: <field name="batch_id"/></li>
                                        <li>Email: <field name="email"/></li>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Search View for Student -->
        <record id="view_op_student_search" model="ir.ui.view">
            <field name="name">op.student.search</field>
            <field name="model">op.student</field>
            <field name="arch" type="xml">
                <search string="Search Student">
                    <field name="name"/>
                    <field name="registration_number"/>
                    <field name="email"/>
                    <separator/>
                    <filter string="Active" name="active_student" domain="[('status', '=', 'active')]"/>
                    <filter string="Alumni" name="alumni_student" domain="[('is_an_alumni', '=', True)]"/>
                    <separator/>
                    <filter string="Batch" name="group_by_batch" context="{'group_by':'batch_id'}"/>
                    <filter string="Program" name="group_by_program" context="{'group_by':'program_id'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by':'status'}"/>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_op_student" model="ir.actions.act_window">
            <field name="name">Students</field>
            <field name="res_model">op.student</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_op_student_search"/>
        </record>


    </data>
</odoo>