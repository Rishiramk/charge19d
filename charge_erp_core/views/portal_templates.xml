<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Portal Homepage Extension -->
        <template id="portal_my_home_school" name="Portal My Home: School" inherit_id="portal.portal_my_home" priority="40">
            <xpath expr="//div[hasclass('o_portal_my_home')]//div[hasclass('o_portal_docs')]" position="inside">

                <!-- My Profile -->
                <div t-if="request.env.user.has_group('charge_erp_core.group_op_student') or request.env.user.has_group('charge_erp_core.group_op_faculty')" class="col-12 col-md-6">
                    <a class="o_portal_my_home_entry d-block p-3 border rounded" t-att-href="'/my/profile'">
                        <i class="fa fa-user fa-2x float-start me-3 text-primary"/>
                        <div class="o_portal_my_home_entry_desc">
                            <h5>My Profile</h5>
                            <span>View and manage your personal information.</span>
                        </div>
                    </a>
                </div>

                <!-- My Courses -->
                <div t-if="course_count" class="col-12 col-md-6">
                    <a class="o_portal_my_home_entry d-block p-3 border rounded" t-att-href="'/my/courses'">
                        <i class="fa fa-graduation-cap fa-2x float-start me-3 text-primary"/>
                        <div class="o_portal_my_home_entry_desc">
                            <h5>My Courses</h5>
                            <span>View your enrolled or assigned courses.</span>
                        </div>
                    </a>
                </div>

                <!-- My Schedule -->
                <div t-if="schedule_count" class="col-12 col-md-6">
                    <a class="o_portal_my_home_entry d-block p-3 border rounded" t-att-href="'/my/schedule'">
                        <i class="fa fa-calendar-alt fa-2x float-start me-3 text-primary"/>
                        <div class="o_portal_my_home_entry_desc">
                            <h5>My Schedule</h5>
                            <span>Check your class schedule and upcoming events.</span>
                        </div>
                    </a>
                </div>

                <!-- My Library -->
                <div t-if="library_count" class="col-12 col-md-6">
                    <a class="o_portal_my_home_entry d-block p-3 border rounded" t-att-href="'/my/library'">
                        <i class="fa fa-book fa-2x float-start me-3 text-primary"/>
                        <div class="o_portal_my_home_entry_desc">
                            <h5>My Library</h5>
                            <span>Manage your library account and issued books.</span>
                        </div>
                    </a>
                </div>

            </xpath>
        </template>

        <!-- My Profile Page -->
        <template id="portal_my_profile" name="My Profile">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs" t-value="[('Home', '/my'), ('My Profile', '/my/profile')]"/>
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">My Profile</t>
                </t>
                <div t-if="student or faculty" class="container">
                    <div class="row">
                        <div class="col-md-4 text-center">
                            <t t-if="student">
                                <img t-att-src="image_data_uri(student.image_1920)" class="img-fluid rounded-circle mb-3" style="max-width: 150px;" alt="Student"/>
                                <h3><t t-esc="student.name"/></h3>
                                <p class="text-muted"><t t-esc="student.program_id.name"/></p>
                            </t>
                            <t t-if="faculty">
                                <img t-att-src="image_data_uri(faculty.image_1920)" class="img-fluid rounded-circle mb-3" style="max-width: 150px;" alt="Faculty"/>
                                <h3><t t-esc="faculty.name"/></h3>
                                <p class="text-muted"><t t-esc="faculty.department_id.name"/></p>
                            </t>
                        </div>
                        <div class="col-md-8">
                            <h4>Personal Information</h4>
                            <hr/>
                            <div class="row">
                                <div class="col-sm-4"><strong>Email</strong></div>
                                <div class="col-sm-8"><t t-esc="student.email if student else faculty.email"/></div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-sm-4"><strong>Phone</strong></div>
                                <div class="col-sm-8"><t t-esc="student.phone if student else faculty.phone"/></div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-sm-4"><strong>Gender</strong></div>
                                <div class="col-sm-8 text-capitalize"><t t-esc="student.gender if student else faculty.gender"/></div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-sm-4"><strong>Date of Birth</strong></div>
                                <div class="col-sm-8"><t t-esc="student.birth_date" t-options='{"widget": "date"}'/></div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- My Courses Page -->
        <template id="portal_my_courses" name="My Courses">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs" t-value="[('Home', '/my'), ('My Courses', '/my/courses')]"/>
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">My Courses</t>
                </t>
                <div t-if="courses" class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr class="bg-light">
                                <th>Course Code</th>
                                <th>Course Name</th>
                                <th>Department</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="courses" t-as="course">
                                <td><span t-field="course.code"/></td>
                                <td><a t-att-href="course.get_absolute_url()"><span t-field="course.name"/></a></td>
                                <td><span t-field="course.department_id.name"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div t-if="not courses" class="alert alert-info">You are not enrolled in any courses.</div>
                <div t-if="pager" class="o_portal_pager"><t t-call="portal.pager"/></div>
            </t>
        </template>

        <!-- My Schedule Page -->
        <template id="portal_my_schedule" name="My Schedule">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs" t-value="[('Home', '/my'), ('My Schedule', '/my/schedule')]"/>
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">My Schedule</t>
                </t>
                <div t-if="sessions" class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr class="bg-light">
                                <th>Session</th>
                                <th>Course</th>
                                <th t-if="request.env.user.has_group('charge_erp_core.group_op_student')">Faculty</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="sessions" t-as="session">
                                <td><span t-field="session.name"/></td>
                                <td><span t-field="session.course_id.name"/></td>
                                <td t-if="request.env.user.has_group('charge_erp_core.group_op_student')"><span t-field="session.faculty_id.name"/></td>
                                <td><span t-field="session.start_datetime" t-options='{"widget": "datetime"}'/></td>
                                <td><span t-field="session.end_datetime" t-options='{"widget": "datetime"}'/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div t-if="not sessions" class="alert alert-info">You have no scheduled sessions.</div>
                <div t-if="pager" class="o_portal_pager"><t t-call="portal.pager"/></div>
            </t>
        </template>

        <!-- My Library Page -->
        <template id="portal_my_library" name="My Library">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs" t-value="[('Home', '/my'), ('My Library', '/my/library')]"/>
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">My Library</t>
                </t>
                <div t-if="issued_books" class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr class="bg-light">
                                <th>Book</th>
                                <th>Issue Date</th>
                                <th>Return Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="issued_books" t-as="book">
                                <td><span t-field="book.book_id.name"/></td>
                                <td><span t-field="book.issue_date" t-options='{"widget": "date"}'/></td>
                                <td><span t-field="book.return_date" t-options='{"widget": "date"}'/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div t-if="not issued_books" class="alert alert-info">You have no books issued from the library.</div>
                <div t-if="pager" class="o_portal_pager"><t t-call="portal.pager"/></div>
            </t>
        </template>

        <!-- Portal Menu Customization: Hide Addresses -->
        <template id="portal_layout_menu_hide_addresses" name="Portal Layout: Hide Addresses" inherit_id="portal.portal_layout" priority="50">
            <xpath expr="//li[a[@href='/my/address']]" position="attributes">
                <attribute name="class" add="d-none" separator=" "/>
            </xpath>
        </template>

        <!-- Portal Menu Customization: Rename Security Link -->
        <template id="portal_layout_menu_rename_security" name="Portal Layout: Rename Security" inherit_id="portal.portal_layout" priority="51">
            <xpath expr="//li[a[@href='/my/security']]//span" position="replace">
                <span>Password Management</span>
            </xpath>
        </template>
    </data>
</odoo>