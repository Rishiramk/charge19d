<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      This is the final, definitive template for the student dashboard,
      following the user's expert guidance. It uses a single, robust xpath
      to replace the main content area, ensuring an error-free,
      upgrade-safe, and full-width layout.
    -->
    <template id="portal_student_dashboard" name="Portal My Home: Student Dashboard" inherit_id="portal.portal_my_home" priority="99">

        <!-- Replace the entire 'o_portal_my_home' div with our custom dashboard -->
        <xpath expr="//div[hasclass('o_portal_my_home')]" position="replace">
            <div class="o_portal_my_home">
                <!-- Full-width dashboard content starts here -->
                <div class="o_portal_content col-12">

                    <!-- Profile Banner -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center">
                                <!-- Profile Image -->
                                <img t-att-src="image_data_uri(student.image_1920)"
                                     class="rounded-circle me-4"
                                     style="width: 100px; height: 100px; object-fit: cover; border: 3px solid #dee2e6;"
                                     alt="Student Profile"/>

                                <!-- Profile Info -->
                                <div class="flex-grow-1">
                                    <h2 class="mb-1"><t t-esc="student.name"/></h2>
                                    <p class="text-muted mb-2 fs-5"><t t-esc="student.program_id.name"/></p>

                                    <div class="d-flex flex-wrap gap-3 small text-muted">
                                        <div class="d-flex align-items-center">
                                            <i class="fa fa-id-badge fa-fw me-2 text-primary"/>
                                            <span><t t-esc="student.roll_number"/></span>
                                        </div>
                                        <div class="d-flex align-items-center">
                                            <i class="fa fa-envelope-o fa-fw me-2 text-primary"/>
                                            <span><t t-esc="student.email"/></span>
                                        </div>
                                        <div t-if="student.phone" class="d-flex align-items-center">
                                            <i class="fa fa-phone fa-fw me-2 text-primary"/>
                                            <span><t t-esc="student.phone"/></span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Edit Button -->
                                <div class="ms-auto">
                                    <a href="/my/details" class="btn btn-light">
                                        <i class="fa fa-pencil me-1"/> Edit
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Dashboard Cards Row -->
                    <div class="row">

                        <!-- My Academic Info -->
                        <div class="col-lg-6 mb-4">
                            <div class="card shadow-sm h-100">
                                <div class="card-header bg-light fw-bold">
                                    <h5 class="mb-0"><i class="fa fa-graduation-cap me-2 text-primary"/> My Academic Info</h5>
                                </div>
                                <div class="card-body">
                                    <p class="mb-2"><strong>Program:</strong> <t t-esc="student.program_id.name"/></p>
                                    <p class="mb-2"><strong>Batch:</strong> <t t-esc="student.batch_id.name"/></p>
                                    <p class="mb-0"><strong>Enrollment Date:</strong> <t t-esc="student.admission_date" t-options='{"widget": "date"}'/></p>
                                </div>
                            </div>
                        </div>

                        <!-- My Courses -->
                        <div class="col-lg-6 mb-4">
                            <div class="card shadow-sm h-100">
                                <div class="card-header bg-light fw-bold">
                                    <h5 class="mb-0"><i class="fa fa-book me-2 text-primary"/> My Courses</h5>
                                </div>
                                <div class="card-body p-3">
                                    <t t-if="courses">
                                        <ul class="list-unstyled mb-0">
                                            <t t-foreach="courses" t-as="course">
                                                <li class="mb-2">
                                                    <strong><t t-esc="course.name"/></strong>
                                                    <span t-if="course.faculty_id" class="text-muted small"> - <t t-esc="course.faculty_id.name"/></span>
                                                </li>
                                            </t>
                                        </ul>
                                    </t>
                                    <t t-else="">
                                        <div class="text-center text-muted p-3">You are not enrolled in any courses.</div>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- My Timetable -->
                        <div class="col-lg-6 mb-4">
                            <div class="card shadow-sm h-100">
                                <div class="card-header bg-light fw-bold">
                                    <h5 class="mb-0"><i class="fa fa-calendar-alt me-2 text-info"/> My Timetable (Next 5)</h5>
                                </div>
                                <div class="card-body p-3">
                                    <t t-if="sessions">
                                        <ul class="list-unstyled mb-0">
                                            <t t-foreach="sessions" t-as="session">
                                                <li class="mb-2">
                                                    <strong><t t-esc="session.course_id.name"/></strong><br/>
                                                    <small class="text-muted"><t t-esc="session.start_datetime" t-options='{"widget": "datetime"}'/></small>
                                                </li>
                                            </t>
                                        </ul>
                                    </t>
                                    <t t-else="">
                                        <div class="text-center text-muted p-3">No upcoming sessions.</div>
                                    </t>
                                </div>
                            </div>
                        </div>

                        <!-- My Library -->
                        <div class="col-lg-6 mb-4">
                            <div class="card shadow-sm h-100">
                                <div class="card-header bg-light fw-bold">
                                    <h5 class="mb-0"><i class="fa fa-book-reader me-2 text-success"/> My Library</h5>
                                </div>
                                <div class="card-body p-3">
                                    <t t-if="issued_books">
                                        <ul class="list-unstyled mb-0">
                                            <t t-foreach="issued_books" t-as="book">
                                                <li class="mb-2">
                                                    <strong><t t-esc="book.name"/></strong><br/>
                                                    <small class="text-muted">Due: <span t-field="book.due_date" t-options='{"widget": "date"}'/></small>
                                                </li>
                                            </t>
                                        </ul>
                                    </t>
                                    <t t-else="">
                                        <div class="text-center text-muted p-3">No books issued.</div>
                                    </t>
                                </div>
                            </div>
                        </div>

                    </div> <!-- end row -->
                </div><!-- This is now the content of the replaced div -->
            </div>
        </xpath>
    </template>

</odoo>