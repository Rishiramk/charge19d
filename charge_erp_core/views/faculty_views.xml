<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List View for Faculty -->
        <record id="view_op_faculty_list" model="ir.ui.view">
            <field name="name">op.faculty.list</field>
            <field name="model">op.faculty</field>
            <field name="arch" type="xml">
                <list string="Faculties">
                    <field name="name"/>
                    <field name="department_id"/>
                    <field name="program_id"/>
                </list>
            </field>
        </record>

        <!-- Form View for Faculty -->
        <record id="view_op_faculty_form" model="ir.ui.view">
            <field name="name">op.faculty.form</field>
            <field name="model">op.faculty</field>
            <field name="arch" type="xml">
                <form string="Faculty">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(charge_erp_core.session_list_action)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-calendar"
                                context="{'search_default_faculty_ids': id}">
                                <field name="session_count" widget="statinfo" string="Sessions"/>
                            </button>
                        </div>
                        <field name="image_1920" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <field name="name" invisible="1" force_save="1"/>
                            <h1>
                                <field name="first_name" placeholder="First Name" style="width: 33%"/>
                                <field name="middle_name" placeholder="Middle Name" style="width: 33%"/>
                                <field name="last_name" placeholder="Last Name" style="width: 34%" required="1"/>
                            </h1>
                        </div>
                        <notebook>
                            <page string="Personal Information">
                                <group>
                                    <group>
                                        <field name="gender"/>
                                        <field name="birth_date"/>
                                    </group>
                                    <group>
                                        <field name="blood_group"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Contact Information">
                                <group>
                                    <field name="phone"/>
                                    <field name="mobile"/>
                                    <field name="email"/>
                                </group>
                                <label for="street"/>
                                <div class="o_address_format">
                                    <field name="street" placeholder="Street..."/>
                                    <field name="street2" placeholder="Street 2..."/>
                                    <field name="city" placeholder="City"/>
                                    <field name="state_id" class="o_address_state" placeholder="State" options='{"no_open": True}'/>
                                    <field name="zip" placeholder="ZIP"/>
                                    <field name="country_id" placeholder="Country" options='{"no_open": True, "no_create": True}'/>
                                </div>
                            </page>
                            <page string="Academic Information">
                                <group>
                                    <field name="department_id"/>
                                    <field name="program_id"/>
                                    <field name="subject_ids" widget="many2many_tags"/>
                                    <field name="office_location"/>
                                </group>
                                <group string="Qualifications and Specialization">
                                    <field name="qualifications"/>
                                    <field name="specialization"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Kanban View for Faculty -->
        <record id="view_op_faculty_kanban" model="ir.ui.view">
            <field name="name">op.faculty.kanban</field>
            <field name="model">op.faculty</field>
            <field name="arch" type="xml">
                <kanban default_group_by="department_id">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="department_id"/>
                    <field name="program_id"/>
                    <field name="image_128"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <field name="image_128" widget="image" class="o_kanban_image"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong><field name="name"/></strong>
                                    <ul>
                                        <li><field name="program_id"/></li>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Action for Faculty -->
        <record id="action_op_faculty" model="ir.actions.act_window">
            <field name="name">Faculties</field>
            <field name="res_model">op.faculty</field>
            <field name="view_mode">kanban,list,form</field>
        </record>


    </data>
</odoo>
