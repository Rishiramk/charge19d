<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List View for Faculty -->
        <record id="view_op_faculty_list" model="ir.ui.view">
            <field name="name">op.faculty.list</field>
            <field name="model">op.faculty</field>
            <field name="arch" type="xml">
                <list string="Faculties">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="email"/>
                    <field name="phone"/>
                </list>
            </field>
        </record>

        <!-- Form View for Faculty -->
        <record id="view_op_faculty_form" model="ir.ui.view">
            <field name="name">op.faculty.form</field>
            <field name="model">op.faculty</field>
            <field name="arch" type="xml">
                <form string="Faculty">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(charge_erp_core.session_list_action)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-calendar"
                                context="{'search_default_faculty_ids': id}">
                                <field name="session_count" widget="statinfo" string="Sessions"/>
                            </button>
                        </div>
                        <field name="image_1920" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Faculty's Name"/>
                            </h1>
                        </div>
                        <notebook>
                            <page string="Personal Information">
                                <group>
                                    <group>
                                        <field name="employee_id"/>
                                        <field name="gender"/>
                                        <field name="birth_date"/>
                                        <field name="age"/>
                                    </group>
                                    <group>
                                        <field name="blood_group"/>
                                        <field name="nationality"/>
                                        <field name="active"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Contact Information">
                                <group>
                                    <field name="phone"/>
                                    <field name="mobile"/>
                                    <field name="email"/>
                                </group>
                                <label for="street"/>
                                <div class="o_address_format">
                                    <field name="street"/>
                                    <field name="street2"/>
                                    <field name="city"/>
                                    <field name="state_id"/>
                                    <field name="zip"/>
                                    <field name="country_id"/>
                                </div>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action for Faculty -->
        <record id="action_op_faculty" model="ir.actions.act_window">
            <field name="name">Faculties</field>
            <field name="res_model">op.faculty</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu for Faculty -->
        <menuitem id="menu_op_faculty" name="Faculties"
                  parent="menu_op_school_root"
                  action="action_op_faculty"
                  sequence="30"/>

    </data>
</odoo>
