<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List View for Faculty -->
        <record id="view_op_faculty_list" model="ir.ui.view">
            <field name="name">op.faculty.list</field>
            <field name="model">op.faculty</field>
            <field name="arch" type="xml">
                <list string="Faculties">
                    <field name="name"/>
                    <field name="gender"/>
                    <field name="nationality"/>
                    <field name="department_id"/>
                    <field name="employee_id"/>
                </list>
            </field>
        </record>

        <!-- Form View for Faculty -->
        <record id="view_op_faculty_form" model="ir.ui.view">
            <field name="name">op.faculty.form</field>
            <field name="model">op.faculty</field>
            <field name="arch" type="xml">
                <form string="Faculty">
                    <header>
                        <button name="action_create_user"
                            string="Create User"
                            type="object"
                            class="btn-primary"
                            invisible="user_id"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <!-- Sessions Smart Button -->
                            <button name="%(charge_erp_core.session_list_action)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-calendar"
                                context="{'search_default_faculty_id': id}">
                                <field name="session_count" widget="statinfo" string="Sessions"/>
                            </button>
                            <!-- Subjects Smart Button -->
                            <button name="%(charge_erp_core.action_op_subject)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-book"
                                context="{'search_default_faculty_ids': id}">
                                <field name="subject_count" widget="statinfo" string="Subjects"/>
                            </button>
                            <!-- Library Smart Button -->
                            <button type="action"
                                class="oe_stat_button"
                                icon="fa-folder"
                                context="{'search_default_faculty_id': id}"
                                name="%(charge_erp_core.action_op_book_issue)d">
                                <field name="library_count" widget="statinfo" string="Library"/>
                            </button>
                            <!-- Employee Smart Button -->
                            <button name="%(hr.open_view_employee_list)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-users"
                                invisible="not employee_id"
                                context="{'search_default_id': employee_id}">
                                <field name="employee_id" readonly="1" widget="statinfo" string="Employee"/>
                            </button>
                        </div>

                        <field name="image_1920" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <h1>
                                <div class="d-flex align-items-center">
                                    <field name="title" placeholder="Title" options='{"no_open": True}' class="me-1"/>
                                    <field name="first_name" placeholder="First Name" class="me-1" required="1"/>
                                    <field name="middle_name" placeholder="Middle Name" class="me-1"/>
                                    <field name="last_name" placeholder="Last Name" required="1"/>
                                </div>
                            </h1>
                        </div>

                        <notebook>
                            <page string="Personal Information">
                                <group>
                                    <group string="Basic Info">
                                        <field name="gender"/>
                                        <field name="birth_date"/>
                                        <field name="blood_group"/>
                                        <field name="nationality" options='{"no_open": True}'/>
                                    </group>
                                    <group string="Contact">
                                        <field name="phone"/>
                                        <field name="mobile"/>
                                        <field name="email"/>
                                    </group>
                                    <group string="Address" name="address">
                                        <label for="street" string="Address"/>
                                        <div class="o_address_format">
                                            <field name="street" placeholder="Street..."/>
                                            <field name="street2" placeholder="Street 2..."/>
                                            <field name="city" placeholder="City"/>
                                            <field name="state_id" class="o_address_state" placeholder="State" options='{"no_open": True}'/>
                                            <field name="zip" placeholder="ZIP"/>
                                            <field name="country_id" placeholder="Country" options='{"no_open": True, "no_create": True}'/>
                                        </div>
                                    </group>
                                    <group string="Additional Info">
                                        <field name="visa_info"/>
                                        <field name="lang_ids" widget="many2many_tags" options='{"no_create": True}'/>
                                        <field name="emergency_contact_id" context="{'show_address': 1}" options='{"no_open": True}'/>
                                    </group>
                                </group>
                            </page>
                            <page string="Academics">
                                <group>
                                    <group string="Qualifications">
                                        <field name="highest_qualification"/>
                                        <field name="specialization"/>
                                    </group>
                                    <group string="Experience &amp; Certifications">
                                        <field name="previous_experience"/>
                                        <field name="certifications" nolabel="1" placeholder="Certifications / Achievements..."/>
                                    </group>
                                </group>
                            </page>
                            <page string="Subjects Detail">
                                <group>
                                    <field name="department_id"/>
                                    <field name="subject_ids" widget="many2many_tags" placeholder="Select Subjects"/>
                                    <field name="course_ids" widget="many2many_tags" placeholder="Select Courses"/>
                                </group>
                            </page>
                            <page string="Sessions">
                                <field name="session_ids"/>
                            </page>
                            <page string="Library Detail">
                                <group>
                                    <field name="library_card_id"/>
                                </group>
                                <field name="issued_book_ids"/>
                            </page>
                            <page string="Health Details">
                                <group>
                                    <field name="medical_conditions"/>
                                    <field name="allergies"/>
                                    <field name="emergency_instructions"/>
                                </group>
                            </page>
                            <page string="Employee / HR Link" groups="hr.group_hr_manager">
                                <group>
                                    <group string="HR Employee">
                                        <button name="action_create_employee"
                                            string="Create Employee"
                                            type="object"
                                            class="btn-primary"
                                            invisible="employee_id"/>
                                        <field name="employee_id"
                                            readonly="1"
                                            invisible="not employee_id"/>
                                    </group>
                                    <group string="System Access">
                                        <field name="user_id"
                                            readonly="1"
                                            invisible="not user_id"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Kanban View for Faculty -->
        <record id="view_op_faculty_kanban" model="ir.ui.view">
            <field name="name">op.faculty.kanban</field>
            <field name="model">op.faculty</field>
            <field name="arch" type="xml">
                <kanban default_group_by="department_id">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="department_id"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="image_128"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <field name="image_128" widget="image" class="o_kanban_image"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong><field name="name"/></strong>
                                    <ul>
                                        <li><field name="department_id"/></li>
                                        <li>Email: <field name="email"/></li>
                                        <li>Phone: <field name="phone"/></li>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Search View for Faculty -->
        <record id="view_op_faculty_search" model="ir.ui.view">
            <field name="name">op.faculty.search</field>
            <field name="model">op.faculty</field>
            <field name="arch" type="xml">
                <search string="Search Faculty">
                    <field name="name"/>
                    <field name="email"/>
                    <separator/>
                    <filter string="Department" name="group_by_department" context="{'group_by':'department_id'}"/>
                    <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
                </search>
            </field>
        </record>

        <!-- Action for Faculty -->
        <record id="action_op_faculty" model="ir.actions.act_window">
            <field name="name">Faculties</field>
            <field name="res_model">op.faculty</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_op_faculty_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new faculty member.
                </p>
            </field>
        </record>

    </data>
</odoo>