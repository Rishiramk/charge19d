<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List View for Faculty -->
        <record id="view_op_faculty_list" model="ir.ui.view">
            <field name="name">op.faculty.list</field>
            <field name="model">op.faculty</field>
            <field name="arch" type="xml">
                <list string="Faculties">
                    <field name="name"/>
                    <field name="department_id"/>
                    <field name="program_id"/>
                </list>
            </field>
        </record>

        <!-- Form View for Faculty -->
        <record id="view_op_faculty_form" model="ir.ui.view">
            <field name="name">op.faculty.form</field>
            <field name="model">op.faculty</field>
            <field name="arch" type="xml">
                <form string="Faculty">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(charge_erp_core.session_list_action)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-calendar"
                                context="{'search_default_faculty_ids': id}">
                                <field name="session_count" widget="statinfo" string="Sessions"/>
                            </button>
                        </div>
                        <field name="image_1920" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <field name="name" invisible="1" force_save="1"/>
                            <h1>
                                <field name="first_name" placeholder="First Name" style="width: 33%"/>
                                <field name="middle_name" placeholder="Middle Name" style="width: 33%"/>
                                <field name="last_name" placeholder="Last Name" style="width: 34%" required="1"/>
                            </h1>
                        </div>
                        <notebook>
                            <page string="Personal Information">
                                <group>
                                    <group>
                                        <field name="gender"/>
                                        <field name="birth_date"/>
                                        <field name="blood_group"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Academic Information">
                                <group>
                                    <field name="department_id"/>
                                    <field name="program_id"/>
                                    <field name="subject_ids" widget="many2many_tags"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action for Faculty -->
        <record id="action_op_faculty" model="ir.actions.act_window">
            <field name="name">Faculties</field>
            <field name="res_model">op.faculty</field>
            <field name="view_mode">list,form</field>
        </record>


    </data>
</odoo>
