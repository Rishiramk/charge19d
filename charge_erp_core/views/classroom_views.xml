<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List View for Classroom -->
        <record id="view_op_classroom_list" model="ir.ui.view">
            <field name="name">op.classroom.list</field>
            <field name="model">op.classroom</field>
            <field name="arch" type="xml">
                <list string="Classrooms">
                    <field name="name"/>
                    <field name="type"/>
                    <field name="capacity"/>
                </list>
            </field>
        </record>

        <!-- Form View for Classroom -->
        <record id="view_op_classroom_form" model="ir.ui.view">
            <field name="name">op.classroom.form</field>
            <field name="model">op.classroom</field>
            <field name="arch" type="xml">
                <form string="Classroom">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="type"/>
                            <field name="capacity"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action for Classroom -->
        <record id="action_op_classroom" model="ir.actions.act_window">
            <field name="name">Classrooms</field>
            <field name="res_model">op.classroom</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu for Classroom -->
        <menuitem id="menu_op_classroom" name="Classrooms"
                  parent="menu_op_school_root"
                  action="action_op_classroom"
                  sequence="40"/>

    </data>
</odoo>