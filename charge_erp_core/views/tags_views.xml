<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List View for op.tags -->
        <record id="view_op_tags_list" model="ir.ui.view">
            <field name="name">op.tags.list</field>
            <field name="model">op.tags</field>
            <field name="arch" type="xml">
                <list string="Tags">
                    <field name="name"/>
                    <field name="description"/>
                </list>
            </field>
        </record>

        <!-- Form View for op.tags -->
        <record id="view_op_tags_form" model="ir.ui.view">
            <field name="name">op.tags.form</field>
            <field name="model">op.tags</field>
            <field name="arch" type="xml">
                <form string="Tag">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action for op.tags -->
        <record id="action_op_tags" model="ir.actions.act_window">
            <field name="name">Tags</field>
            <field name="res_model">op.tags</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>