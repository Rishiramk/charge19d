<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="action_charge_erp_dashboard" model="ir.actions.client">
            <field name="name">School Dashboard</field>
            <field name="tag">charge_erp_core.dashboard</field>
        </record>

        <!-- Fallback action to prevent errors if a user's home action is set to a missing dashboard -->
        <record id="action_spreadsheet_dashboard" model="ir.actions.client">
            <field name="name">Dashboard</field>
            <field name="tag">charge_erp_core.dashboard</field>
        </record>

        <menuitem
            id="menu_charge_erp_dashboard"
            name="Dashboard"
            action="action_charge_erp_dashboard"
            web_icon="charge_erp_core,static/description/icon.png"
            groups="charge_erp_core.group_op_manager"
            sequence="1"/>

    </data>
</odoo>