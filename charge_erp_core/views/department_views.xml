<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List View for Department -->
        <record id="view_op_department_list" model="ir.ui.view">
            <field name="name">op.department.list</field>
            <field name="model">op.department</field>
            <field name="arch" type="xml">
                <list string="Departments">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="parent_id"/>
                </list>
            </field>
        </record>

        <!-- Form View for Department -->
        <record id="view_op_department_form" model="ir.ui.view">
            <field name="name">op.department.form</field>
            <field name="model">op.department</field>
            <field name="arch" type="xml">
                <form string="Department">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(charge_erp_core.action_op_course_department)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-book">
                                <field name="course_count" widget="statinfo" string="Courses"/>
                            </button>
                            <button name="%(charge_erp_core.action_op_faculty_department)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-users">
                                <field name="faculty_count" widget="statinfo" string="Faculties"/>
                            </button>
                            <button name="%(charge_erp_core.action_op_student_department)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-graduation-cap">
                                <field name="student_count" widget="statinfo" string="Students"/>
                            </button>
                             <button name="%(charge_erp_core.action_op_subject_department)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-book">
                                <field name="subject_count" widget="statinfo" string="Subjects"/>
                            </button>
                            <button name="%(charge_erp_core.action_op_batch_department)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-sitemap">
                                <field name="batch_count" widget="statinfo" string="Batches"/>
                            </button>
                        </div>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="parent_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Actions for Department Smart Buttons -->
        <record id="action_op_course_department" model="ir.actions.act_window">
            <field name="name">Courses</field>
            <field name="res_model">op.course</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('department_id', '=', active_id)]</field>
            <field name="context">{'default_department_id': active_id}</field>
        </record>

        <record id="action_op_faculty_department" model="ir.actions.act_window">
            <field name="name">Faculties</field>
            <field name="res_model">op.faculty</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('department_id', '=', active_id)]</field>
            <field name="context">{'default_department_id': active_id}</field>
        </record>

        <record id="action_op_student_department" model="ir.actions.act_window">
            <field name="name">Students</field>
            <field name="res_model">op.student</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('program_id.department_id', '=', active_id)]</field>
        </record>

        <record id="action_op_subject_department" model="ir.actions.act_window">
            <field name="name">Subjects</field>
            <field name="res_model">op.subject</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('department_id', '=', active_id)]</field>
            <field name="context">{'default_department_id': active_id}</field>
        </record>

        <record id="action_op_batch_department" model="ir.actions.act_window">
            <field name="name">Batches</field>
            <field name="res_model">op.batch</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('program_id.department_id', '=', active_id)]</field>
        </record>

        <!-- Action for Department -->
        <record id="action_op_department" model="ir.actions.act_window">
            <field name="name">Departments</field>
            <field name="res_model">op.department</field>
            <field name="view_mode">list,form</field>
        </record>


    </data>
</odoo>
