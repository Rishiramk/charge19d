<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List View for Course -->
        <record id="view_op_course_list" model="ir.ui.view">
            <field name="name">op.course.list</field>
            <field name="model">op.course</field>
            <field name="arch" type="xml">
                <list string="Courses">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="evaluation_type"/>
                </list>
            </field>
        </record>

        <!-- Form View for Course -->
        <record id="view_op_course_form" model="ir.ui.view">
            <field name="name">op.course.form</field>
            <field name="model">op.course</field>
            <field name="arch" type="xml">
                <form string="Course">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(charge_erp_core.session_list_action)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-calendar">
                                <field name="session_count" widget="statinfo" string="Sessions"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                            </group>
                            <group>
                                <field name="parent_id"/>
                                <field name="department_id"/>
                                <field name="evaluation_type"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Students">
                                <field name="student_course_ids">
                                    <list>
                                        <field name="student_id"/>
                                        <field name="academic_year_id"/>
                                        <field name="status"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action for Course -->
        <record id="action_op_course" model="ir.actions.act_window">
            <field name="name">Courses</field>
            <field name="res_model">op.course</field>
            <field name="view_mode">list,form</field>
        </record>


    </data>
</odoo>
