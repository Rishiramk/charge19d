<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Form View -->
        <record model="ir.ui.view" id="session_form_view">
            <field name="name">session.form</field>
            <field name="model">op.session</field>
            <field name="arch" type="xml">
                <form string="Session Form">
                    <header>
                        <button name="action_start_session" string="Start Session" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_mark_completed" string="Mark as Completed" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                        <button name="action_cancel" string="Cancel" type="object" invisible="state in ['completed', 'cancelled']"/>
                        <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state != 'cancelled'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,completed"/>
                        <button name="%(charge_erp_core.action_op_attendee_wizard)d"
                                type="action"
                                string="Add Attendees"
                                class="oe_highlight"
                                context="{'default_session_id': id}"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="faculty_id"/>
                            <field name="course_id"/>
                            <field name="academic_year_id"/>
                            <field name="start_date"/>
                            <field name="duration"/>
                            <field name="seats"/>
                        </group>
                        <notebook>
                            <page string="Attendees">
                                <field name="attendee_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record model="ir.ui.view" id="session_tree_view">
            <field name="name">session.tree</field>
            <field name="model">op.session</field>
            <field name="arch" type="xml">
                <list string="Session Tree">
                    <field name="name"/>
                    <field name="course_id"/>
                    <field name="start_date"/>
                    <field name="duration"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <!-- List View -->
        <record model="ir.ui.view" id="session_list_view">
            <field name="name">session.list</field>
            <field name="model">op.session</field>
            <field name="arch" type="xml">
                <list string="Session List">
                    <field name="name"/>
                    <field name="course_id"/>
                    <field name="academic_year_id"/>
                </list>
            </field>
        </record>

        <!-- Calendar View -->
        <record model="ir.ui.view" id="session_calendar_view">
            <field name="name">session.calendar</field>
            <field name="model">op.session</field>
            <field name="arch" type="xml">
                <calendar string="Session Calendar" date_start="start_date" color="course_id">
                    <field name="name"/>
                </calendar>
            </field>
        </record>

        <!-- Search View for Session -->
        <record model="ir.ui.view" id="session_search_view">
            <field name="name">session.search</field>
            <field name="model">op.session</field>
            <field name="arch" type="xml">
                <search string="Search Sessions">
                    <field name="name"/>
                    <field name="course_id"/>
                    <field name="faculty_id"/>
                    <field name="attendee_ids" string="Attendee"/>
                    <separator/>
                    <filter string="Draft" name="draft_sessions" domain="[('state', '=', 'draft')]"/>
                    <filter string="In Progress" name="in_progress_sessions" domain="[('state', '=', 'in_progress')]"/>
                    <separator/>
                    <filter string="Course" name="group_by_course" context="{'group_by':'course_id'}"/>
                    <filter string="Faculty" name="group_by_faculty" context="{'group_by':'faculty_id'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by':'state'}"/>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record model="ir.actions.act_window" id="session_list_action">
            <field name="name">Sessions</field>
            <field name="res_model">op.session</field>
            <field name="view_mode">list,form,calendar</field>
            <field name="search_view_id" ref="session_search_view"/>
        </record>


    </data>
</odoo>
