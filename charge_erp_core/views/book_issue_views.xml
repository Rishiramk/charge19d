<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- List view for Book Issue -->
        <record id="view_op_book_issue_list" model="ir.ui.view">
            <field name="name">op.book.issue.list</field>
            <field name="model">op.book.issue</field>
            <field name="arch" type="xml">
                <list string="Issued Books">
                    <field name="name"/>
                    <field name="faculty_id"/>
                    <field name="student_id"/>
                    <field name="issue_date"/>
                    <field name="due_date"/>
                </list>
            </field>
        </record>

        <!-- Form view for Book Issue -->
        <record id="view_op_book_issue_form" model="ir.ui.view">
            <field name="name">op.book.issue.form</field>
            <field name="model">op.book.issue</field>
            <field name="arch" type="xml">
                <form string="Book Issue">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="faculty_id"/>
                            <field name="student_id"/>
                            <field name="issue_date"/>
                            <field name="due_date"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action for Book Issue -->
        <record id="action_op_book_issue" model="ir.actions.act_window">
            <field name="name">Issued Books</field>
            <field name="res_model">op.book.issue</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>