<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record model="ir.module.category" id="module_category_charge_erp">
            <field name="name">Charge ERP</field>
            <field name="description">Helps you manage your school</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_op_student" model="res.groups">
            <field name="name">Student</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_op_faculty" model="res.groups">
            <field name="name">Faculty</field>
            <field name="implied_ids" eval="[(4, ref('group_op_student'))]"/>
        </record>

        <record id="group_op_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_op_faculty'))]"/>
        </record>

        <!-- Add admin and root user to the new Manager group -->
        <record id="base.user_admin" model="res.users">
            <field name="groups_id" eval="[(4, ref('charge_erp_core.group_op_manager'))]"/>
        </record>

        <record id="base.user_root" model="res.users">
            <field name="groups_id" eval="[(4, ref('charge_erp_core.group_op_manager'))]"/>
        </record>

    </data>
</odoo>