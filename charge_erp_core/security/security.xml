<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record model="ir.module.category" id="module_category_charge_erp">
            <field name="name">Charge ERP</field>
            <field name="description">Helps you manage your school</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_op_student" model="res.groups">
            <field name="name">Student</field>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="group_op_faculty" model="res.groups">
            <field name="name">Faculty</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_op_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="implied_ids" eval="[(4, ref('charge_erp_core.group_op_faculty'))]"/>
        </record>

        <!-- Record Rules for Faculty -->
        <record id="op_faculty_rule_faculty" model="ir.rule">
            <field name="name">Faculty can only see their own record</field>
            <field name="model_id" ref="model_op_faculty"/>
            <field name="groups" eval="[(4, ref('group_op_faculty'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="op_session_rule_faculty" model="ir.rule">
            <field name="name">Faculty can only see their own sessions</field>
            <field name="model_id" ref="model_op_session"/>
            <field name="groups" eval="[(4, ref('group_op_faculty'))]"/>
            <field name="domain_force">[('faculty_id.user_id', '=', user.id)]</field>
        </record>

        <record id="op_student_rule_faculty" model="ir.rule">
            <field name="name">Faculty can only see students in their department</field>
            <field name="model_id" ref="model_op_student"/>
            <field name="groups" eval="[(4, ref('group_op_faculty'))]"/>
            <field name="domain_force">[('program_id.department_id', 'in', user.env['op.faculty'].search([('user_id','=',user.id)]).mapped('department_id').ids)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Record Rule for Student Book Issue -->
        <record id="op_book_issue_rule_student" model="ir.rule">
            <field name="name">Student can only see their own book issue records</field>
            <field name="model_id" ref="model_op_book_issue"/>
            <field name="groups" eval="[(4, ref('group_op_student'))]"/>
            <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
        </record>

        <!-- Record Rule for Student Profile -->
        <record id="op_student_rule_student" model="ir.rule">
            <field name="name">Student can only see their own profile</field>
            <field name="model_id" ref="model_op_student"/>
            <field name="groups" eval="[(4, ref('group_op_student'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>

        <!-- Record Rule for Student Course Enrollment -->
        <record id="op_course_enrollment_rule_student" model="ir.rule">
            <field name="name">Student can only see their own course enrollments</field>
            <field name="model_id" ref="model_op_course_enrollment"/>
            <field name="groups" eval="[(4, ref('group_op_student'))]"/>
            <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
        </record>

        <!-- Record Rule for Student Sessions -->
        <record id="op_session_rule_student" model="ir.rule">
            <field name="name">Student can only see their own sessions</field>
            <field name="model_id" ref="model_op_session"/>
            <field name="groups" eval="[(4, ref('group_op_student'))]"/>
            <field name="domain_force">[('student_partner_ids', 'in', [user.partner_id.id])]</field>
        </record>

    </data>
</odoo>