<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record model="ir.module.category" id="module_category_charge_erp">
            <field name="name">Charge ERP</field>
            <field name="description">Helps you manage your school</field>
            <field name="sequence">20</field>
        </record>

        <record id="group_op_student" model="res.groups">
            <field name="name">Student</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_op_faculty" model="res.groups">
            <field name="name">Faculty</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_op_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="implied_ids" eval="[(4, ref('charge_erp_core.group_op_faculty'))]"/>
        </record>

        <!-- Department-based Security Rules -->
        <!-- Manager Rules (Permissive) -->
        <record id="op_student_manager_rule" model="ir.rule">
            <field name="name">Student: Manager can see all</field>
            <field name="model_id" ref="model_op_student"/>
            <field name="groups" eval="[(4, ref('group_op_manager'))]"/>
            <field name="domain_force">[(1,'=',1)]</field>
        </record>
        <record id="op_faculty_manager_rule" model="ir.rule">
            <field name="name">Faculty: Manager can see all</field>
            <field name="model_id" ref="model_op_faculty"/>
            <field name="groups" eval="[(4, ref('group_op_manager'))]"/>
            <field name="domain_force">[(1,'=',1)]</field>
        </record>

        <!-- Faculty Rules (Restrictive) -->
        <record id="op_student_faculty_rule" model="ir.rule">
            <field name="name">Student: Faculty can only see students in their departments</field>
            <field name="model_id" ref="model_op_student"/>
            <field name="groups" eval="[(4, ref('group_op_faculty'))]"/>
            <field name="domain_force">[('program_id.department_id', 'in', [user.faculty_id.department_id.id] + user.faculty_id.allowed_department_ids.ids)]</field>
        </record>
        <record id="op_faculty_faculty_rule" model="ir.rule">
            <field name="name">Faculty: Faculty can only see faculty in their departments</field>
            <field name="model_id" ref="model_op_faculty"/>
            <field name="groups" eval="[(4, ref('group_op_faculty'))]"/>
            <field name="domain_force">['|', ('id', '=', user.faculty_id.id), '|', ('department_id', 'in', [user.faculty_id.department_id.id] + user.faculty_id.allowed_department_ids.ids), ('allowed_department_ids', 'in', [user.faculty_id.department_id.id] + user.faculty_id.allowed_department_ids.ids)]</field>
        </record>

    </data>
</odoo>