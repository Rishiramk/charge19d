<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Computer Science Courses -->
        <record id="demo_course_cs_intro" model="op.course">
            <field name="name">Introductory Computer Science</field>
            <field name="code">CS-INTRO</field>
            <field name="evaluation_type">GPA</field>
            <field name="department_id" ref="demo_department_cs"/>
        </record>

        <record id="demo_course_cs_advanced" model="op.course">
            <field name="name">Advanced Computer Science</field>
            <field name="code">CS-ADV</field>
            <field name="evaluation_type">GPA</field>
            <field name="department_id" ref="demo_department_cs"/>
        </record>

        <!-- Humanities Courses -->
        <record id="demo_course_hist_survey" model="op.course">
            <field name="name">History Survey Course</field>
            <field name="code">HIST-SURVEY</field>
            <field name="evaluation_type">normal</field>
            <field name="department_id" ref="demo_department_humanities"/>
        </record>

        <!-- Science Courses -->
        <record id="demo_course_sci_foundation" model="op.course">
            <field name="name">Foundational Sciences</field>
            <field name="code">SCI-FOUND</field>
            <field name="evaluation_type">CWA</field>
            <field name="department_id" ref="demo_department_science"/>
        </record>

    </data>
</odoo>